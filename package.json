{
  "name": "flare-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "postinstall": "wrangler types",
    "deploy": "bun run scripts/bootstrap.ts",
    "teardown": "bun run scripts/teardown.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:integration": "tsc --noEmit -p test/integration/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "budget:cpu": "vitest run test/budget.cpu.test.tsx",
    "budget:check": "bun run scripts/budget-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flare-kit-db --local",
    "size": "wrangler deploy --dry-run --outdir dist-check && node scripts/check-size.mjs",
    "bench:ttfb": "bun run scripts/bench-ttfb.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^18.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.35.0"
  }
}
