{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Required for Cache-Control response headers to actually be honored —
  // without this, Cloudflare never consults a cache before running the
  // Worker, regardless of what headers a route returns (TRD §7.4).
  "cache": { "enabled": true },

  // Estáticos: gratis, ilimitados, NO cuentan como request de Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  "d1_databases": [
    { "binding": "DB", "database_name": "flare-kit-db", "database_id": "REPLACE_WITH_D1_ID" }
  ],

  // SOLO lectura-caché. Prohibido escribir por-request (1,000 escrituras/día).
  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "REPLACE_WITH_KV_ID" }
  ],

  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "flare-kit-assets" }
  ],

  "ai": { "binding": "AI" },

  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],

  "triggers": { "crons": ["0 3 * * *"] },

  "vars": { "APP_ENV": "production" }
}
